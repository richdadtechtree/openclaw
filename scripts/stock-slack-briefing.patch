+def send_slack_photo(photo_path, caption="", channel=None):
+    """
+    슬랙 채널에 이미지(사진)를 업로드한다. 성공 시 True.
+
+    Slack 최신 업로드 방식(files.getUploadURLExternal → 파일 PUT →
+    files.completeUploadExternal)을 사용한다. (구 files.upload 는 폐지 예정)
+    필요 봇 스코프: files:write  (그리고 봇이 채널에 참여해 있어야 함)
+    """
+    token = SLACK_BOT_TOKEN
+    channel = channel or SLACK_BRIEFING_CHANNEL
+    if not token or not channel:
+        print("[Error] SLACK_BOT_TOKEN 또는 SLACK_BRIEFING_CHANNEL 이 .env 에 없습니다.")
+        return False
+
+    try:
+        filename = os.path.basename(photo_path)
+        length = os.path.getsize(photo_path)
+
+        # 1) 업로드 URL 발급
+        r1 = requests.get(
+            "https://slack.com/api/files.getUploadURLExternal",
+            headers={"Authorization": f"Bearer {token}"},
+            params={"filename": filename, "length": length},
+            timeout=30,
+        )
+        d1 = r1.json()
+        if not d1.get("ok"):
+            print(f"[Error] Slack getUploadURLExternal 실패: {d1}")
+            return False
+        upload_url = d1["upload_url"]
+        file_id = d1["file_id"]
+
+        # 2) 파일 바이트 업로드
+        with open(photo_path, "rb") as f:
+            r2 = requests.post(upload_url, data=f.read(), timeout=60)
+        if r2.status_code != 200:
+            print(f"[Error] Slack 파일 업로드 실패: HTTP {r2.status_code}")
+            return False
+
+        # 3) 업로드 완료 + 채널 게시
+        payload = {
+            "files": [{"id": file_id, "title": caption or filename}],
+            "channel_id": channel,
+        }
+        if caption:
+            payload["initial_comment"] = caption
+        r3 = requests.post(
+            "https://slack.com/api/files.completeUploadExternal",
+            headers={
+                "Authorization": f"Bearer {token}",
+                "Content-Type": "application/json; charset=utf-8",
+            },
+            json=payload,
+            timeout=30,
+        )
+        d3 = r3.json()
+        if d3.get("ok"):
+            return True
+        print(f"[Error] Slack completeUploadExternal 실패: {d3}")
+    except Exception as e:
+        print(f"[Error] Failed to send photo via Slack: {e}")
+    return False
