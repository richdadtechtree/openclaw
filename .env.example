# ============================================================
#  openclaw 비밀 키 (.env 템플릿)
# ============================================================
#  이 파일(.env.example)은 "빈 양식"입니다. git 에 올라갑니다.
#  실제 값은 복사본 .env 에만 넣으세요. (.env 는 git 에 안 올라감)
#
#  만드는 법:   cp .env.example .env   후 아래 값을 채우기
#  또는 마법사:  scripts/setup-env.sh   (하나씩 물어보고 자동 저장)
#
#  openclaw 는 ~/.openclaw/.env 를 자동으로 읽고,
#  openclaw.json 안의 ${변수명} 을 이 값으로 치환합니다.
# ============================================================

# ── 1. 텔레그램 봇 토큰 ──────────────────────────────────────
#  발급처: 텔레그램 @BotFather → /mybots → 봇 선택 → API Token
TELEGRAM_BOT_TOKEN_DEFAULT=
TELEGRAM_BOT_TOKEN_PT=

# ── 2. Brave 웹 검색 API 키 ─────────────────────────────────
#  발급처: https://api-dashboard.search.brave.com/
BRAVE_API_KEY=

# ── 3. 게이트웨이 인증 토큰 ─────────────────────────────────
#  새로 만들려면:  openssl rand -hex 24
GATEWAY_TOKEN=

# ── 4. Slack 계정별 토큰 (openclaw.json 에서 ${} 참조) ───────
#  발급처: https://api.slack.com/apps
#  [default 계정]
SLACK_BOT_TOKEN_DEFAULT=
SLACK_APP_TOKEN_DEFAULT=
#  [cafein 계정]
SLACK_BOT_TOKEN_CAFEIN=
SLACK_APP_TOKEN_CAFEIN=
#  [ddupro 계정]
SLACK_BOT_TOKEN_DDUPRO=
SLACK_APP_TOKEN_DDUPRO=
#  [keepgoing / GYM종국 계정]
SLACK_BOT_TOKEN_KEEPGOING=
SLACK_APP_TOKEN_KEEPGOING=
#  [bookman 계정]
SLACK_BOT_TOKEN_BOOKMAN=
SLACK_APP_TOKEN_BOOKMAN=

# ── 5. Gemini(Google) API 키 ────────────────────────────────
GEMINI_API_KEY=

# ── 6. Notion ────────────────────────────────────────────────
NOTION_TOKEN=
NOTION_BRIEFING_DB=
NOTION_BRIEFING_TARGET=
NOTION_BOOK_TARGET=
NOTION_ARTICLE_TARGET=
NOTION_TIP_TARGET=
NOTION_TROUBLESHOOT_TOKEN=

# ── 7. Google Sheets 웹앱 ────────────────────────────────────
SHEETS_WEBAPP_URL=
SHEETS_WEBAPP_SECRET=

# ── 8. 한국투자증권(KIS) API ────────────────────────────────
#  REAL(실전) 또는 VIRTUAL(모의)
KIS_CANV_MODE=REAL
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=

# ── 9. 서버 / 기타 ──────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
DISABLE_YFINANCE=1
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_STOCK_CHANNEL=
SLACK_NEWS_CHANNEL=
SLACK_ALERT_CHANNEL=
# 슬랙 뷰어(/slack)는 이 채널(#gpt) 대화만 표시. 비우면 기본값(#gpt 채널 ID) 사용.
SLACK_GPT_CHANNEL=C0BTHMT2M7X

# ── 10. PT 대시보드 구글 로그인(OAuth) ──────────────────────
#  scripts/pt_dashboard.py (포트 5001) 접근을 구글 로그인으로 잠근다.
#  이 4개(ID/SECRET/허용이메일/세션키)를 채워야 인증이 켜진다. 비면 '인증 없이' 열림.
#  발급처: https://console.cloud.google.com/apis/credentials
#    → "사용자 인증 정보 만들기" → "OAuth 클라이언트 ID" → 애플리케이션 유형 "웹 애플리케이션"
#    → 승인된 리디렉션 URI 에 아래 콜백 주소를 정확히 등록:  https://<대시보드주소>/auth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
#  들어올 수 있는 구글 계정(콤마로 여러 개). 비면 아무도 못 들어온다.
PT_ALLOWED_EMAILS=bbonoyo@gmail.com
#  세션 서명용 고정 키 (없으면 재시작 시 로그인 풀림).  만들기:  openssl rand -hex 32
FLASK_SECRET_KEY=
#  (선택) 콜백 URL 을 고정하고 싶을 때만. 없으면 접속 주소로 자동 계산.
#GOOGLE_OAUTH_REDIRECT_URI=https://your-domain/auth/callback
#  (선택) https(리버스 프록시)가 아니라 순수 http 로 테스트할 때만 0 으로.
#PT_COOKIE_SECURE=1

# ── 11. AI 토론 채널(#ai-토론, 다중 모델 토론) ───────────────
#  scripts/debate.py 는 Gemini/Qwen/Mistral 은 각 공급자 REST API 직접 호출,
#  GPT 는 별도 API 키 없이 openclaw 게이트웨이(Chat Completions HTTP API)를 거쳐
#  ChatGPT Plus 구독 OAuth 세션(전용 무툴 에이전트 "debate-gpt")으로 호출한다.
#  ⚠️ GATEWAY_TOKEN 은 위 3번 항목에 이미 있음(게이트웨이가 이미 쓰고 있는 값 그대로 재사용,
#     새로 발급 불필요). GEMINI_API_KEY 도 위 5번 항목 값을 그대로 재사용(별도 발급 불필요).
#  발급처: OpenRouter(https://openrouter.ai/keys, Qwen 무료 모델용),
#          Mistral(https://console.mistral.ai/, Studio 무료 모드)
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
#  모델 ID — 무료 모델은 자주 바뀐다. 구축 당일 아래를 실제 사용 가능한 ID로 확인 후 채울 것.
#  비우면 스크립트 기본값(placeholder)이 쓰이며, 반드시 검증 필요.
DEBATE_GEMINI_MODEL=gemini-flash-latest
#  (선택) GPT 게이트웨이 경로를 서버 환경에 맞게 바꿀 때만 사용. 보통 안 건드려도 됨.
#DEBATE_GATEWAY_URL=http://127.0.0.1:18789/v1/chat/completions
#DEBATE_GPT_AGENT=openclaw/debate-gpt
DEBATE_QWEN_MODEL=
DEBATE_QWEN_MODEL_FALLBACK=
DEBATE_MISTRAL_MODEL=
DEBATE_MISTRAL_MODEL_FALLBACK=
#  (선택) 분당 호출 제한 / 모델별 타임아웃(초). 비우면 기본값(3회 / 25초) 사용.
DEBATE_RATE_LIMIT_PER_MIN=3
DEBATE_TIMEOUT_SEC=25
#  새 슬랙 채널(#ai-토론)의 채널 ID. 채널 생성 후 openclaw.json 의
#  "C000000AIDEBATE" placeholder 를 이 값으로 직접 바꿔야 한다(이 값은 참고용 메모일 뿐,
#  openclaw.json 의 ${} 치환 대상이 아니다 — 채널ID는 비밀이 아니라서 직접 기입).
#SLACK_AI_DEBATE_CHANNEL_ID_MEMO=
