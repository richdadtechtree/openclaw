# openclaw 비밀 키 환경변수 템플릿
# ---------------------------------------------------------------
# 실제 값은 이 파일이 아니라 .env 에 넣으세요. (.env 는 .gitignore 로 제외됨)
# 서버에서 아래 명령으로 live openclaw.json 에서 자동 생성할 수 있습니다:
#   scripts/extract-secrets-to-env.sh
# ---------------------------------------------------------------

# Brave 웹 검색 API 키  (openclaw 가 이 env 를 자동 인식)
BRAVE_API_KEY=

# 게이트웨이 인증 토큰   (--gateway-token-ref-env GATEWAY_TOKEN 로 참조)
GATEWAY_TOKEN=

# --- 참고 ---
# 텔레그램 봇 토큰은 openclaw 가 env 참조를 지원하지 않아 openclaw.json 에 남습니다.
# openclaw.json 자체는 .gitignore 로 git 에 올라가지 않으므로 노출 대상이 아닙니다.
# (아래는 관리 편의를 위한 기록용 — 실제 사용은 openclaw.json 의 channels.telegram.accounts)
# TELEGRAM_BOT_TOKEN_DEFAULT=
# TELEGRAM_BOT_TOKEN_PT=
