# ============================================================
#  openclaw 비밀 키 (.env 템플릿)
# ============================================================
#  이 파일(.env.example)은 "빈 양식"입니다. git 에 올라갑니다.
#  실제 값은 복사본 .env 에만 넣으세요. (.env 는 git 에 안 올라감)
#
#  만드는 법:   cp .env.example .env   후 아래 값을 채우기
#  또는 마법사:  scripts/setup-env.sh   (하나씩 물어보고 자동 저장)
#
#  openclaw 는 ~/.openclaw/.env 를 자동으로 읽고,
#  openclaw.json 안의 ${변수명} 을 이 값으로 치환합니다.
# ============================================================

# ── 1. 텔레그램 봇 토큰 (신문 분석가 / 기본 봇) ──────────────
#  발급처: 텔레그램 @BotFather → /mybots → 봇 선택 → API Token
#  형식:  숫자:영문숫자  (예 8900296531:AA....)
TELEGRAM_BOT_TOKEN_DEFAULT=

# ── 2. 텔레그램 봇 토큰 (PT 트레이너 봇) ────────────────────
#  발급처: 위와 동일, PT 트레이너용 봇의 토큰
TELEGRAM_BOT_TOKEN_PT=

# ── 3. Brave 웹 검색 API 키 ─────────────────────────────────
#  발급처: https://api-dashboard.search.brave.com/ → API Keys
#  형식:  BSA... 로 시작
BRAVE_API_KEY=

# ── 3-1. Slack 앱 토큰 (channels.slack.appToken) ────────────
#  발급처: https://api.slack.com/apps → 앱 → Basic Information → App-Level Tokens
#  형식:  xapp-...
SLACK_APP_TOKEN=

# ── 3-2. Slack 봇 토큰 (channels.slack.botToken) ────────────
#  발급처: 같은 앱 → OAuth & Permissions → Bot User OAuth Token
#  형식:  xoxb-...
SLACK_BOT_TOKEN=

# ── 3-3. Slack PT 채널 (PT 트레이너 대화/브리핑) ────────────
#  PT 기록 브리핑을 올릴 채널 ID (C...). 없으면 SLACK_BRIEFING_CHANNEL 로 폴백.
SLACK_PT_CHANNEL=

# ── 4. Gemini(Google) API 키 ────────────────────────────────
#  발급처: https://aistudio.google.com/apikey → Create API key
#  형식:  AIza... 로 시작
GEMINI_API_KEY=

# ── 5. 게이트웨이 인증 토큰 ─────────────────────────────────
#  openclaw 게이트웨이 접속용 토큰. 아무 랜덤 문자열이면 됩니다.
#  새로 만들려면:  openssl rand -hex 24
GATEWAY_TOKEN=
