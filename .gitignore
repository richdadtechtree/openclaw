# 민감 환경 변수 파일
.env
.env.*
*.env
!.env.example

# Python 및 파이썬 가상환경/캐시
__pycache__/
*.py[cod]
venv/
.venv/

# 로그 및 실행 데이터
*.log
*.sqlite3
data/*.log
.env
__pycache__/
venv/
credentials/
identity/
*.json
logs/

# openclaw 런타임 생성물 (git 추적 제외 — 디스크에는 유지됨)
# 서버가 실행 중 계속 쓰기 때문에 추적하면 pull 충돌/데이터 손실이 발생함
agents/*/sessions/
agents/*/memory/
workspace/memory/
cron/runs/
media/inbound/
media/outbound/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# 백업 / 스냅샷 파일 (민감정보 포함 가능)
*.bak
*.bak.*
*.last-good

# 동기화해야 하는 설정 파일은 위의 *.json 규칙에서 예외 처리 (추적 유지)
!cron/jobs.json

# stock vendor: 코드(.py)만 추적. 런타임/미디어/데이터/비밀은 서버 전용.
#   (venv/ *.sqlite* *.log __pycache__ *.json *.env 는 위 전역 규칙에서 이미 제외됨.
#    monitored_stocks.json = 감시종목 데이터 → *.json 규칙으로 추적 안 됨(서버 유지).)
stock/venv/
stock/screenshots/
stock/*.png
stock/*.jpg
stock/*.db

# openclaw 런타임/툴 생성물 (서버에만 존재, git 추적 금지)
#   git-auto-push.sh 의 `git add -A` 가 실수로 담는 것을 방지.
tools/
workspace-attestations/
*.migrated

# 슬랙 발신 로그 (슬랙 뷰어용 원천 데이터 — 서버 전용, 내용 포함)
slack_logs/

# npm 플러그인 폴더 보호 (git clean -fd 로부터 보호)
npm/
plugin-skills/

# 시크릿/민감 정보 파일
openclaw.json.bak*
openclaw.json.clobbered*
workspace/MEMORY.md
workspace/get_notion_book.py
agents/main/agent/codex-home/shell_snapshots/

# 민감 정보 제외
openclaw.json.bak*
openclaw.json.clobbered*
agents/main/agent/codex-home/shell_snapshots/
workspace/MEMORY.md
workspace/get_notion_book.py
workspace/bookman/TOOLS.md
workspace/agents/bookman/TOOLS.md

# openclaw agent 캐시/임시 폴더
agents/*/agent/codex-home/.tmp/
agents/*/agent/codex-home/tmp/
agents/*/agent/codex-home/sessions/
workspace/*/agent/codex-home/.tmp/
workspace/*/agent/codex-home/tmp/

# 미디어 수신 임시 폴더
agents/*/media/inbound/openclaw-staged-*/
