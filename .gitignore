# 민감 환경 변수 파일
.env
.env.*
*.env
!.env.example

# Python 및 파이썬 가상환경/캐시
__pycache__/
*.py[cod]
venv/
.venv/

# 로그 및 실행 데이터
*.log
*.sqlite3
data/*.log
.env
__pycache__/
venv/
credentials/
identity/
*.json
logs/

# openclaw 런타임 생성물 (git 추적 제외 — 디스크에는 유지됨)
# 서버가 실행 중 계속 쓰기 때문에 추적하면 pull 충돌/데이터 손실이 발생함
agents/*/sessions/
agents/*/memory/
workspace/memory/
cron/runs/
media/inbound/
media/outbound/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# 백업 / 스냅샷 파일 (민감정보 포함 가능)
*.bak
*.bak.*
*.last-good

# 동기화해야 하는 설정 파일은 위의 *.json 규칙에서 예외 처리 (추적 유지)
!cron/jobs.json
